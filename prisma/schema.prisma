generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AdminRole {
  OWNER
  STAFF
}

enum GuardianRelationship {
  PARENT
  GUARDIAN
  OTHER
}

enum PersonStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum PackageType {
  MONTHLY
  PER_SESSION
}

enum BillingPeriod {
  MONTHLY
  THREE_MONTHS
  YEARLY
}

enum LessonType {
  PRIVATE
  GROUP
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DiscountKind {
  PERCENT_OFF
  FIXED_OFF
  FREE_SESSIONS
  FREE_MONTH
  REDUCED_RATE
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED_BY_TUTOR
  CANCELLED_BY_STUDENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum ReminderType {
  SESSION_UPCOMING
  PAYMENT_DUE
  PACKAGE_ENDING
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum EmailTemplateType {
  PAYMENT_REMINDER
  SESSION_REMINDER
  ANNOUNCEMENT
  CUSTOM
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantRunStatus {
  RUNNING
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
}

enum AssistantToolRunStatus {
  PENDING_CONFIRMATION
  RUNNING
  COMPLETED
  FAILED
  REJECTED
  EXPIRED
}

// ─── Core Identity ────────────────────────────────────────────────────────────

model Admin {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  email       String
  name        String
  role        AdminRole @default(STAFF)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments               Payment[]
  assistantThreads       AssistantThread[]
  assistantConfirmations AssistantToolRun[] @relation("AssistantToolRunConfirmedBy")
}

model Guardian {
  id             String               @id @default(cuid())
  firstName      String
  lastName       String
  avatarUrl      String?
  avatarPublicId String?
  email          String?
  phone          String
  relationship   GuardianRelationship @default(PARENT)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  students StudentGuardian[]
}

model Student {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  avatarUrl      String?
  avatarPublicId String?
  dob            DateTime?
  email          String?
  phone          String?
  school         String?
  gradeLevel     String?
  status         PersonStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  sessionAttendance SessionAttendance[]
  payments          Payment[]
  discounts         Discount[]
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

// ─── Teaching ─────────────────────────────────────────────────────────────────

model Tutor {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  avatarUrl      String?
  avatarPublicId String?
  email          String       @unique
  phone          String
  hourlyRate     Decimal      @db.Decimal(10, 2)
  status         PersonStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subjects    TutorSubject[]
  enrollments Enrollment[]
  sessions    Session[]
  groups      Group[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutors      TutorSubject[]
  packages    Package[]
  enrollments Enrollment[]
  sessions    Session[]
  groups      Group[]
}

model TutorSubject {
  tutorId   String
  subjectId String

  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([tutorId, subjectId])
}

// ─── Packages & Enrollments ───────────────────────────────────────────────────

model Package {
  id              String        @id @default(cuid())
  name            String
  type            PackageType
  billingPeriod   BillingPeriod @default(MONTHLY)
  lessonType      LessonType    @default(PRIVATE)
  subjectId       String?
  basePrice       Decimal       @db.Decimal(10, 2)
  sessionsPerWeek Int?
  durationMinutes Int
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subject     Subject?     @relation(fields: [subjectId], references: [id])
  enrollments Enrollment[]
}

model Enrollment {
  id                  String           @id @default(cuid())
  studentId           String
  packageId           String
  tutorId             String
  subjectId           String
  startDate           DateTime         @db.Date
  endDate             DateTime?        @db.Date
  status              EnrollmentStatus @default(ACTIVE)
  priceAtEnrollment   Decimal          @db.Decimal(10, 2)
  customPriceOverride Decimal?         @db.Decimal(10, 2)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  groupId             String?

  student           Student             @relation(fields: [studentId], references: [id])
  package           Package             @relation(fields: [packageId], references: [id])
  tutor             Tutor               @relation(fields: [tutorId], references: [id])
  subject           Subject             @relation(fields: [subjectId], references: [id])
  sessions          Session[]
  sessionAttendance SessionAttendance[]
  recurrenceRules   RecurrenceRule[]
  discounts         Discount[]
  group             Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payments          Payment[]

  @@index([studentId, status])
}

model Discount {
  id            String       @id @default(cuid())
  enrollmentId  String?
  studentId     String?
  kind          DiscountKind
  value         Decimal      @db.Decimal(10, 2)
  temporary     Boolean      @default(false)
  validFrom     DateTime?
  validUntil    DateTime?
  usesRemaining Int?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ─── Scheduling ───────────────────────────────────────────────────────────────

model RecurrenceRule {
  id              String    @id @default(cuid())
  enrollmentId    String?
  groupId         String?
  dayOfWeek       Int
  startTime       String
  timeZone        String    @default("America/Los_Angeles")
  durationMinutes Int
  intervalWeeks   Int       @default(1)
  room            String?
  color           String?
  startsOn        DateTime  @db.Date
  endsOn          DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sessions   Session[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  tutorId   String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor           Tutor            @relation(fields: [tutorId], references: [id])
  subject         Subject          @relation(fields: [subjectId], references: [id])
  enrollments     Enrollment[]
  recurrenceRules RecurrenceRule[]

  @@unique([tutorId, name])
  @@index([tutorId])
  @@index([subjectId])
}

model Session {
  id                      String        @id @default(cuid())
  enrollmentId            String?
  tutorId                 String
  subjectId               String
  scheduledFor            DateTime
  durationMinutes         Int
  room                    String?
  status                  SessionStatus @default(SCHEDULED)
  recurrenceRuleId        String?
  recurrenceOccurrenceFor DateTime?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  enrollment     Enrollment?         @relation(fields: [enrollmentId], references: [id])
  tutor          Tutor               @relation(fields: [tutorId], references: [id])
  subject        Subject             @relation(fields: [subjectId], references: [id])
  recurrenceRule RecurrenceRule?     @relation(fields: [recurrenceRuleId], references: [id])
  attendance     SessionAttendance[]
  reminders      Reminder[]

  @@unique([recurrenceRuleId, recurrenceOccurrenceFor])
  @@index([scheduledFor])
  @@index([tutorId, scheduledFor])
}

model SessionAttendance {
  id           String        @id @default(cuid())
  sessionId    String
  studentId    String
  enrollmentId String?
  status       SessionStatus @default(SCHEDULED)
  billable     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([sessionId, studentId])
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Payment {
  id           String        @id @default(cuid())
  studentId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  paidAt       DateTime
  recordedById String
  notes        String?
  coversMonth  String?
  enrollmentId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student    Student     @relation(fields: [studentId], references: [id])
  recordedBy Admin       @relation(fields: [recordedById], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@index([studentId, paidAt])
  @@index([enrollmentId, coversMonth])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model EmailTemplate {
  id        String            @id @default(cuid())
  name      String
  subject   String
  body      String
  type      EmailTemplateType @default(CUSTOM)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Reminder {
  id             String         @id @default(cuid())
  type           ReminderType
  recipientEmail String
  payload        Json
  scheduledFor   DateTime
  sentAt         DateTime?
  sessionId      String?
  status         ReminderStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  session Session? @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, recipientEmail, type])
  @@index([scheduledFor, status])
}

// ─── AI Assistant ─────────────────────────────────────────────────────────────

model AssistantThread {
  id                     String    @id @default(cuid())
  adminId                String
  title                  String
  contextSummary         String?
  summarizedMessageCount Int       @default(0)
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  admin    Admin              @relation(fields: [adminId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]
  runs     AssistantRun[]

  @@index([adminId, archivedAt, updatedAt])
}

model AssistantMessage {
  id          String               @id @default(cuid())
  threadId    String
  runId       String?
  role        AssistantMessageRole
  content     String
  attachments Json?
  createdAt   DateTime             @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  run    AssistantRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([runId])
}

model AssistantRun {
  id                String             @id @default(cuid())
  threadId          String
  clientTurnId      String
  status            AssistantRunStatus @default(RUNNING)
  model             String
  hasAttachments    Boolean            @default(false)
  resumeInput       Json?
  inputTokens       Int?
  outputTokens      Int?
  reasoningTokens   Int?
  cachedInputTokens Int?
  cacheWriteTokens  Int?
  error             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?

  thread   AssistantThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]
  toolRuns AssistantToolRun[]

  @@unique([threadId, clientTurnId])
  @@index([threadId, status])
}

model AssistantToolRun {
  id                   String                 @id @default(cuid())
  runId                String
  callId               String
  namespace            String
  toolName             String
  arguments            Json
  preview              Json?
  result               Json?
  status               AssistantToolRunStatus
  requiresConfirmation Boolean                @default(false)
  expiresAt            DateTime?
  confirmedById        String?
  confirmedAt          DateTime?
  error                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  completedAt          DateTime?

  run         AssistantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  confirmedBy Admin?       @relation("AssistantToolRunConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([runId, callId])
  @@index([runId, status])
  @@index([expiresAt, status])
}
